{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "name": "Street Tycoon Game Balance Config",
  "description": "Tunable parameters for economic simulation, progression, and game balance",
  "lastUpdated": "2025-11-08",
  
  "economy": {
    "starting": {
      "cash": 100,
      "level": 1,
      "experience": 0,
      "description": "Initial player state"
    },
    
    "income": {
      "tapIncomeBase": 1.0,
      "tapIncomeMultiplier": 0.5,
      "tapIncomeMultiplierPerLevel": 0.1,
      "passiveIncomeMultiplier": 0.5,
      "helperIncomeBase": 0.5,
      "helperIncomeMultiplier": 0.3,
      "description": "Base income values and multipliers"
    },
    
    "expenses": {
      "upgradeBaseCost": 100,
      "upgradeScalingFactor": 1.15,
      "helperBaseCost": 50,
      "helperScalingFactor": 1.3,
      "characterBaseCost": 500,
      "characterScalingFactor": 1.5,
      "description": "Cost formulas: baseCost * (scalingFactor ^ count)"
    },
    
    "limits": {
      "minCash": 0,
      "maxCash": 1000000000,
      "maxDebt": 100000,
      "negativeBalanceAllowed": false,
      "description": "Financial constraints"
    }
  },
  
  "loans": {
    "enabled": true,
    "minPlayerLevel": 10,
    
    "terms": {
      "short": {
        "durationDays": 7,
        "interestRate": 0.05,
        "minAmount": 100,
        "maxAmount": 10000,
        "description": "1 week loan at 5% interest"
      },
      "medium": {
        "durationDays": 14,
        "interestRate": 0.08,
        "minAmount": 500,
        "maxAmount": 25000,
        "description": "2 week loan at 8% interest"
      },
      "long": {
        "durationDays": 30,
        "interestRate": 0.12,
        "minAmount": 1000,
        "maxAmount": 50000,
        "description": "1 month loan at 12% interest"
      }
    },
    
    "limits": {
      "maxSimultaneousLoans": 3,
      "maxTotalDebt": 100000,
      "requiredCashBuffer": 100,
      "description": "Debt limits and requirements"
    },
    
    "penalties": {
      "lateFeeRate": 0.02,
      "gracePeriodDays": 2,
      "defaultThresholdDays": 7,
      "creditScoreImpact": -10,
      "description": "Penalties for late/missed payments"
    }
  },
  
  "progression": {
    "levels": {
      "xpBase": 100,
      "xpScalingFactor": 1.5,
      "maxLevel": 100,
      "xpPerCashEarned": 0.1,
      "xpPerUpgrade": 10,
      "xpPerHelper": 5,
      "description": "XP formula: xpBase * (scalingFactor ^ (level - 1))"
    },
    
    "rewards": {
      "cashRewardBase": 50,
      "cashRewardScaling": 1.3,
      "bonusMultiplierPerLevel": 0.1,
      "description": "Rewards given on level up"
    },
    
    "unlocks": {
      "5": ["Family System", "Basic Spending Categories"],
      "10": ["Loans System", "Short Term Loans"],
      "15": ["Investment System", "Asset Trading"],
      "20": ["Premium Stalls", "Advanced Helpers"],
      "25": ["Medium Term Loans", "Property Investments"],
      "30": ["Special Events", "Seasonal Content"],
      "40": ["Long Term Loans", "Business Expansion"],
      "50": ["Prestige System", "Advanced Features"]
    }
  },
  
  "events": {
    "enabled": true,
    "generation": {
      "baseChancePerTick": 0.001,
      "minTicksBetweenEvents": 600,
      "maxPendingEvents": 5,
      "description": "Event generation rates (at 100ms ticks, 600 = 60 seconds)"
    },
    
    "distribution": {
      "positiveWeight": 0.6,
      "negativeWeight": 0.4,
      "neutralWeight": 0.0,
      "description": "60% positive, 40% negative events"
    },
    
    "impact": {
      "positiveMin": 50,
      "positiveMax": 1500,
      "negativeMin": 50,
      "negativeMax": 500,
      "scalingWithLevel": true,
      "levelScalingFactor": 1.2,
      "description": "Financial impact ranges for random events"
    },
    
    "types": {
      "positive": [
        {"name": "Customer Tip", "weight": 1.0, "impactMin": 50, "impactMax": 200},
        {"name": "Food Festival", "weight": 0.8, "impactMin": 100, "impactMax": 500},
        {"name": "Social Media Fame", "weight": 0.6, "impactMin": 200, "impactMax": 800},
        {"name": "Bulk Order", "weight": 0.5, "impactMin": 300, "impactMax": 1000},
        {"name": "Competition Win", "weight": 0.3, "impactMin": 500, "impactMax": 1500}
      ],
      "negative": [
        {"name": "Equipment Repair", "weight": 1.0, "impactMin": 50, "impactMax": 150},
        {"name": "Health Inspection", "weight": 0.7, "impactMin": 100, "impactMax": 300},
        {"name": "Ingredient Spoilage", "weight": 0.8, "impactMin": 75, "impactMax": 200},
        {"name": "Theft", "weight": 0.5, "impactMin": 50, "impactMax": 250},
        {"name": "Utility Bill", "weight": 0.6, "impactMin": 100, "impactMax": 400}
      ]
    }
  },
  
  "assets": {
    "stalls": {
      "tea": {
        "baseCost": 100,
        "baseIncome": 1.0,
        "maintenanceCost": 0.1,
        "upgradeMultiplier": 1.5
      },
      "dosa": {
        "baseCost": 200,
        "baseIncome": 1.5,
        "maintenanceCost": 0.15,
        "upgradeMultiplier": 1.5
      },
      "momos": {
        "baseCost": 300,
        "baseIncome": 2.0,
        "maintenanceCost": 0.2,
        "upgradeMultiplier": 1.5
      },
      "juice": {
        "baseCost": 150,
        "baseIncome": 1.2,
        "maintenanceCost": 0.12,
        "upgradeMultiplier": 1.5
      }
    },
    
    "depreciation": {
      "enabled": true,
      "ratePerTick": 0.0001,
      "minimumValuePercent": 0.1,
      "description": "Assets depreciate slowly, minimum 10% of purchase price"
    }
  },
  
  "family": {
    "enabled": true,
    "unlockLevel": 5,
    
    "milestones": {
      "marriage": {
        "cost": 10000,
        "requiredLevel": 5,
        "bonusMultiplier": 1.05
      },
      "firstChild": {
        "cost": 5000,
        "requiredLevel": 8,
        "monthlyExpenseIncrease": 500
      },
      "additionalChild": {
        "cost": 5000,
        "maxChildren": 4,
        "monthlyExpenseIncrease": 500
      }
    },
    
    "categories": {
      "housing": {
        "levels": [
          {"name": "Street", "cost": 0, "happiness": 1},
          {"name": "Small Room", "cost": 1000, "happiness": 2},
          {"name": "Apartment", "cost": 3000, "happiness": 3},
          {"name": "House", "cost": 5000, "happiness": 4}
        ]
      },
      "transport": {
        "levels": [
          {"name": "Walking", "cost": 0, "happiness": 1},
          {"name": "Bicycle", "cost": 500, "happiness": 2},
          {"name": "Scooter", "cost": 1000, "happiness": 3},
          {"name": "Car", "cost": 2000, "happiness": 4}
        ]
      },
      "food": {
        "levels": [
          {"name": "Street Food", "cost": 300, "happiness": 1},
          {"name": "Home Cooking", "cost": 1000, "happiness": 2},
          {"name": "Restaurant", "cost": 2000, "happiness": 3},
          {"name": "Premium", "cost": 3000, "happiness": 4}
        ]
      },
      "education": {
        "levels": [
          {"name": "None", "cost": 0, "happiness": 1},
          {"name": "Public", "cost": 2000, "happiness": 2},
          {"name": "Private", "cost": 5000, "happiness": 3},
          {"name": "Premium", "cost": 8000, "happiness": 4}
        ]
      },
      "health": {
        "levels": [
          {"name": "No Insurance", "cost": 0, "happiness": 1},
          {"name": "Basic", "cost": 1000, "happiness": 2},
          {"name": "Premium", "cost": 2500, "happiness": 3},
          {"name": "Complete", "cost": 4000, "happiness": 4}
        ]
      }
    },
    
    "happiness": {
      "optimalExpenseRatioMin": 0.05,
      "optimalExpenseRatioMax": 0.20,
      "bonusMultiplierHigh": 1.2,
      "bonusMultiplierLow": 0.8,
      "description": "Happiness affects income multiplier"
    }
  },
  
  "simulation": {
    "tickRate": {
      "intervalMs": 100,
      "description": "Game tick every 100ms (10 ticks per second)"
    },
    
    "performance": {
      "targetFPS": 60,
      "maxParticles": 100,
      "asyncThreshold": 1000,
      "description": "Performance targets and limits"
    },
    
    "persistence": {
      "autoSaveIntervalSeconds": 30,
      "maxSaveHistoryCount": 10,
      "compressionEnabled": false,
      "description": "Save system configuration"
    },
    
    "offline": {
      "maxAccrualHours": 4,
      "efficiencyPenalty": 0.3,
      "description": "Offline earnings: 4 hours max at 70% efficiency"
    }
  },
  
  "tuning": {
    "difficulty": {
      "easy": {
        "incomeMultiplier": 1.5,
        "expenseMultiplier": 0.75,
        "xpMultiplier": 1.5
      },
      "normal": {
        "incomeMultiplier": 1.0,
        "expenseMultiplier": 1.0,
        "xpMultiplier": 1.0
      },
      "hard": {
        "incomeMultiplier": 0.75,
        "expenseMultiplier": 1.25,
        "xpMultiplier": 0.8
      }
    },
    
    "debugMode": {
      "enabled": false,
      "startingCash": 100000,
      "fastLevelUp": false,
      "allUnlocked": false,
      "description": "Debug settings for testing"
    }
  },
  
  "testing": {
    "deterministicMode": {
      "enabled": true,
      "fixedSeed": 12345,
      "description": "Use fixed random seed for test reproducibility"
    },
    
    "validationRules": {
      "minTransactionAmount": 0.01,
      "maxTransactionAmount": 1000000,
      "maxTransactionsPerSecond": 100,
      "description": "Validation constraints"
    }
  },
  
  "notes": {
    "balancePhilosophy": "Early game focuses on tap income and basic upgrades. Mid-game introduces passive income and family expenses. Late game adds loans and investments for strategic planning.",
    "progressionCurve": "Exponential XP requirements with linear XP gains create natural pacing. Players should level up every 10-20 minutes in early game, slowing to 30-60 minutes in late game.",
    "economicLoop": "Income -> Spend on upgrades -> Higher passive income -> Unlock new content -> Reinvest in business -> Manage family expenses -> Balance debt vs growth",
    "retentionHooks": "Daily rewards, offline earnings, achievement-based unlocks, family milestones, random events for variety"
  }
}
