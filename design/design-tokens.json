          "backgroundColor": "#FFFFFF",
          "overlayColor": "rgba(0, 0, 0, 0.5)",
          "borderRadius": "16dp",
          "padding": "24dp",
          "maxWidth": "400dp"
        }
      }
    }
  },
  
  "gameBalance": {
    "economic": {
      "startingCash": 100,
      "minCash": 0,
      "maxCash": 1000000000,
      "incomeMultiplier": 1.0,
      "expenseMultiplier": 1.0
    },
    
    "loans": {
      "minLoanAmount": 100,
      "maxLoanAmount": 50000,
      "interestRates": {
        "short": 0.05,
        "medium": 0.08,
        "long": 0.12
      },
      "maxSimultaneousLoans": 3
    },
    
    "levels": {
      "xpPerLevel": 100,
      "xpMultiplier": 1.5,
      "maxLevel": 100,
      "rewardMultiplier": 1.2
    },
    
    "events": {
      "randomEventChance": 0.1,
      "positiveEventWeight": 0.6,
      "negativeEventWeight": 0.4
    }
  },
  
  "accessibility": {
    "contrast": {
      "minimum": 4.5,
      "enhanced": 7.0
    },
    "textScale": {
      "min": 0.85,
      "max": 2.0,
      "default": 1.0
    },
    "touchTarget": {
      "minimum": "48dp"
    },
    "animationReducedMotion": {
      "enabled": true,
      "durationMultiplier": 0.5
    }
  },
  
  "performance": {
    "targetFrameRate": 60,
    "maxParticles": 100,
    "asyncLoadThreshold": "1mb",
    "cacheSize": "50mb"
  },
  
  "figmaLink": "https://www.figma.com/design/[PLACEHOLDER]/street-tycoon-design-system"
