          "borderColor": "rgba(255, 255, 255, 0.3)",
          "borderWidth": "1dp",
          "borderRadius": "16dp",
          "elevation": "0dp",
          "blur": "10dp",
          "padding": {
            "horizontal": "16dp",
            "vertical": "16dp"
          }
