    "MapNode": {
      "variants": {
        "locked": {
          "size": "80dp",
          "backgroundColor": "#9E9E9E",
          "iconColor": "#FFFFFF",
          "borderColor": "#757575",
          "borderWidth": "2dp",
          "opacity": 0.5
        },
        "unlocked": {
          "size": "80dp",
          "backgroundColor": "#66BB6A",
          "iconColor": "#FFFFFF",
          "borderColor": "#4CAF50",
          "borderWidth": "2dp",
          "opacity": 1.0,
          "glowColor": "#4CAF50",
          "glowRadius": "8dp"
        },
        "active": {
          "size": "80dp",
          "backgroundColor": "#FF6B35",
          "iconColor": "#FFFFFF",
