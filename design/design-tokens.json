      "xs": "2dp",
      "sm": "4dp",
      "md": "8dp",
      "lg": "12dp",
      "xl": "16dp",
      "xxl": "24dp",
      "xxxl": "32dp",
      "huge": "48dp",
      "massive": "64dp"
    },
    
    "component": {
      "buttonPadding": {
        "horizontal": "16dp",
        "vertical": "12dp"
      },
      "cardPadding": {
        "horizontal": "16dp",
        "vertical": "16dp"
      },
      "listItemPadding": {
        "horizontal": "16dp",
        "vertical": "12dp"
      },
      "screenPadding": {
        "horizontal": "16dp",
        "vertical": "16dp"
      }
    }
  },
  
  "borderRadius": {
    "none": "0dp",
    "sm": "2dp",
    "md": "4dp",
    "lg": "8dp",
    "xl": "12dp",
    "xxl": "16dp",
    "xxxl": "24dp",
    "full": "9999dp"
  },
  
  "elevation": {
    "0": "0dp",
    "1": "2dp",
    "2": "4dp",
    "3": "8dp",
    "4": "12dp",
    "5": "16dp",
    "6": "24dp"
  },
  
  "animation": {
    "duration": {
      "instant": 0,
      "fast": 150,
      "normal": 300,
      "slow": 500,
      "slower": 800,
      "slowest": 1200
    },
    
    "easing": {
      "linear": "linear",
      "easeIn": "cubic-bezier(0.4, 0, 1, 1)",
      "easeOut": "cubic-bezier(0, 0, 0.2, 1)",
      "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "bounce": "cubic-bezier(0.68, -0.55, 0.265, 1.55)"
    },
    
    "specs": {
      "balanceCountUp": {
        "duration": 800,
        "easing": "easeOut",
        "interpolation": "exponential"
      },
      "transactionSlide": {
        "duration": 300,
        "easing": "easeInOut",
        "translateY": "100%"
      },
      "levelUpCelebration": {
        "duration": 1200,
        "easing": "spring",
        "scale": {
          "from": 0.8,
          "to": 1.2,
          "final": 1.0
        }
      },
      "mapReveal": {
        "duration": 800,
        "easing": "easeOut",
        "opacity": {
          "from": 0,
          "to": 1
        },
        "scale": {
          "from": 0.9,
          "to": 1.0
        }
      },
      "buttonPress": {
        "duration": 150,
        "easing": "easeInOut",
        "scale": {
          "from": 1.0,
          "to": 0.95
        }
      },
      "pulse": {
        "duration": 1000,
        "easing": "easeInOut",
        "repeat": "infinite",
        "scale": {
          "from": 1.0,
          "to": 1.05
        }
      }
    }
  },
  
